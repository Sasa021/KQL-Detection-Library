// name: Entra ID password spray
// attack_technique: T1110.003
// data_source: SigninLogs
// description: Looks for one source IP failing Entra ID sign-ins for more than one account in a 15 minute window. ResultType 50126 is the invalid username or password error. The starter thresholds are 2 accounts and 2 failures so a tiny lab check can be seen. This is not a tuned production alert.
// false_positives: A shared NAT address, a lab where two people mistype passwords, and a legacy client retrying old credentials.
// tuning_notes: PLACEHOLDER. After you run this query in the lab, write the threshold you kept, any accounts or hosts you excluded, and why.
// atomic_test: T1110.003-4
// status: untested

// Run in Microsoft Sentinel Logs, in the workspace from Sentinel-Home-SOC-Lab.
// Needs the Microsoft Entra ID connector with Sign-in logs, and a tenant license that exports those logs.
// Do not run Atomic Red Team password spray tests that target every account. See docs/atomic-red-team-testing.md.
let min_users = 2;
let min_failures = 2;
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType == "50126"
| where isnotempty(UserPrincipalName)
| summarize
    FailedSignIns = count(),
    Users = dcount(UserPrincipalName),
    UserList = make_set(UserPrincipalName),
    Apps = make_set(AppDisplayName),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, 15m)
| where Users >= min_users and FailedSignIns >= min_failures
| order by Users desc, FailedSignIns desc
